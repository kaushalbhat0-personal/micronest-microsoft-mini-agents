{
  "name": "micronest-whatsapp",
  "version": "0.1.0",
  "description": "MicroNest WhatsApp Web assistant — assisted sequential sending",
  "manifest_version": 3,
  "permissions": ["tabs", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "dist/sidepanel/index.html"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3000/*",
    "https://*.micronest.app/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/whatsapp.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/overlay.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.micronest.app/*"
      ],
      "js": ["src/content/bridge.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "MicroNest"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
